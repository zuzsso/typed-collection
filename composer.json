{
  "name": "zuzsso/typed-collection",
  "description": "Common shareable functionality",
  "type": "library",
  "authors": [
    {
      "name": "Nico Santamaria",
      "email": "ndsans@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "TypedCollection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TypedCollection\\Tests\\": "tests/"
    }
  },
  "require": {
    "php-di/php-di": "^7.0",
    "ext-json": "*",
    "zuzsso/di-manifest": "2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.2.3",
    "phpmd/phpmd": "@stable",
    "friendsofphp/php-cs-fixer": "*"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/zuzsso/di-manifest"
    }
  ]
}
